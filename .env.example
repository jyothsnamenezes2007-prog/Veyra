# Veyra Marketplace Environment Variables

# Frontend Environment Variables (Vite)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Optional TURN server configuration for WebRTC
# VITE_TURN_SERVER_URL=turn:your.turn.server:3478
# VITE_TURN_USERNAME=your_username
# VITE_TURN_CREDENTIAL=your_credential

# Server-Only Configuration (Never exposed to client bundles or browser)
PORT=3001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
NODE_ENV=development
